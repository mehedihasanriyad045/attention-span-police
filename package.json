{
  "name": "attention-span-police",
  "description": "Your attention span has been reported missing.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "assets": "node scripts/assets.mjs",
    "e2e": "node -e \"process.env.ASP_E2E=1\" && wxt build && node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wxt": "^0.21.5"
  }
}
